    PDUDestruct
    PDUGetModuleIds
    PDUGetDeviceIds
    PDUOpenDevice
    PDUOpenResource
    PDUGetResourceIds
    PDUGetObjectId
    PDUGetObjectIds
    PDUGetVersion
    PDUGetStatus
    PDUCreateComLogicalLink
    PDUDestroyComLogicalLink
    PDUConnect
    PDUDisconnect
    PDUStartComPrimitive
    PDUCancelComPrimitive
    PDUGetEventItem
    PDURegisterEventCallback
